# ╔══════════════════════════════════════════════════════════════╗
# ║  AgroApp - .gitignore raíz (Flutter + NestJS)                  ║
# ╚══════════════════════════════════════════════════════════════╝

# ───────── Flutter / Dart (app movil/agro_app) ─────────
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/doc/api/
**/.fvm/
*.lock.bak

# Archivos generados de Flutter
**/generated_plugin_registrant.*
**/flutter_export_environment.sh
**/GeneratedPluginRegistrant.*

# Perfil de Chrome usado por flutter run (¡miles de archivos!)
**/chrome-device/

# Android
**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/local.properties
**/android/key.properties
*.keystore
*.jks

# iOS
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework/
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/ephemeral/

# ───────── NestJS / Node (agro_backend) ─────────
**/node_modules/
**/dist/
**/.env
**/.env.local
**/.env.*.local
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/coverage/
**/.nyc_output/

# ───────── Editores / Sistema ─────────
.idea/
*.iml
*.swp
.DS_Store
Thumbs.db
*.log
